# ==============================================================================
# TRAVEL LENS AI - Environment Configuration Example
# Prepared for IBM Db2 TechX Summit 2026 Db2 Hack Challenge
# ==============================================================================
# Note: Copy this file to '.env' and fill in your actual credentials.
# Never commit your real '.env' file or sensitive secrets to version control!
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Required for AI storytelling, photo lens, and trip planning)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Application URL (Used for Cloud Run / production deployment links)
APP_URL="http://localhost:3000"

# ==============================================================================
# IBM Db2 Database Configuration
# ==============================================================================
# Obtain these credentials from your IBM Cloud Console:
# Resource List -> Db2 Service Instance -> Service Credentials
# ==============================================================================

# IBM Db2 Hostname (e.g., dashdb-txn-sbox-yp-dal09-xx.services.dal.bluemix.net)
DB2_HOSTNAME="YOUR_DB2_HOSTNAME_HERE"

# IBM Db2 Port (Default SSL port is 50001; non-SSL is 50000)
DB2_PORT=50001

# IBM Db2 Database Name (Default is usually 'BLUDB')
DB2_DATABASE="BLUDB"

# IBM Db2 Username / User ID
DB2_UID="YOUR_DB2_USERNAME_HERE"

# IBM Db2 Password
DB2_PWD="YOUR_DB2_PASSWORD_HERE"

# Connection Security Protocol ('SSL' recommended for IBM Cloud)
DB2_SECURITY="SSL"
